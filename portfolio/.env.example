# Preview is the safe default. Public builds require all release-evidence.json
# checks and actual legal copy to be reviewed, plus explicit operator approval.
PORTFOLIO_PUBLICATION_MODE=preview
# Enable only after verifying HTTPS for the approved production host.
PORTFOLIO_HSTS_ENABLED=false

# Prepared optional Brevo + shared Upstash Redis adapter. No services are provisioned.
# Recipient is fixed in server code to mngmt@synapedia.com.
# Keep disabled until privacy, data flows, receiver and sender are verified.
CONTACT_DELIVERY_ENABLED=false
CONTACT_PROVIDER=brevo
CONTACT_ORIGIN=
CONTACT_FROM_EMAIL=
CONTACT_SENDER_VERIFIED=false
CONTACT_BREVO_API_KEY=
CONTACT_REDIS_REST_URL=
CONTACT_REDIS_REST_TOKEN=
CONTACT_ABUSE_SECRET=
# An approved edge must overwrite the chosen header; direct origins must be closed.
# Supported: x-nf-client-connection-ip or x-vercel-forwarded-for.
CONTACT_TRUSTED_IP_HEADER=
CONTACT_TRUSTED_PROXY_VERIFIED=false
